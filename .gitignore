# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# Raw benchmark files are fetched with scripts/download_data.py
data/ETT-small/*.csv
data/illness/*.csv

# Model checkpoints and run logs
checkpoints/
*.pt
*.log

# Editor and OS files
.vscode/
.idea/
.DS_Store

# Train and validation copies are rebuilt by scripts/make_trainval.py; the
# manifest with their digests is committed.
data/trainval/**/*.csv

# Raw records, checkpoints and per-window validation errors downloaded from
# Modal are committed (owner's request, 2026-11-24); results/ledger.jsonl is
# still the source of every reported number.
!results/runs/**/*.pt

# Regenerated from the runs files by scripts/replay.py --summarize-only.
results/search/**/budget.json

# Agent worktrees.
.claude/worktrees/
